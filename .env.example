# ============================================
# VCF Depot Manager - Environment Configuration
# ============================================

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string

# Authentication (Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# VCFDT Configuration
VCFDT_VERSION=9.1.0.0100
VCFDT_BIN_PATH=/opt/vcfdt/bin/vcf-download-tool
VCF_VERSION=9.1.0
VCF_SKU=VCF

# Persistent Volume Paths (mounted into container)
DEPOT_STORE=/data/depot
TOKEN_DIR=/data/tokens
LOG_DIR=/data/logs

# Download Defaults
DEFAULT_DOWNLOAD_TYPE=INSTALL
DEFAULT_COMPONENT=

# Web Server
FLASK_PORT=5000
FLASK_HOST=0.0.0.0
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120